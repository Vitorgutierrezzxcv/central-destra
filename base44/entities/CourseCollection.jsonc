{
  "name": "CourseCollection",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "T\u00edtulo da cole\u00e7\u00e3o"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da cole\u00e7\u00e3o"
    },
    "thumbnail_url": {
      "type": "string",
      "description": "URL da thumbnail da cole\u00e7\u00e3o"
    },
    "order": {
      "type": "number",
      "description": "Ordem de exibi\u00e7\u00e3o"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Se est\u00e1 ativa e vis\u00edvel"
    },
    "company_id": {
      "type": "string",
      "description": "ID da empresa (se for exclusivo para um cliente, deixe vazio para todos)"
    },
    "category": {
      "type": "string",
      "enum": [
        "tutorial",
        "mentoria",
        "treinamento",
        "outro"
      ],
      "default": "tutorial",
      "description": "Categoria da cole\u00e7\u00e3o"
    }
  },
  "required": [
    "title"
  ]
}