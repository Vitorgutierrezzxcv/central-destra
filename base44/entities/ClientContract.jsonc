{
  "name": "ClientContract",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "ID do projeto relacionado"
    },
    "company_id": {
      "type": "string",
      "description": "ID da empresa cliente"
    },
    "title": {
      "type": "string",
      "description": "T\u00edtulo do contrato"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o ou escopo resumido"
    },
    "contract_number": {
      "type": "string",
      "description": "N\u00famero do contrato (ex: CONT-2024-001)"
    },
    "contract_value": {
      "type": "number",
      "description": "Valor total do contrato"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Data de in\u00edcio do contrato"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "Data de t\u00e9rmino do contrato"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "signed",
        "active",
        "completed",
        "cancelled"
      ],
      "default": "draft",
      "description": "Status do contrato"
    },
    "file_url": {
      "type": "string",
      "description": "URL do arquivo do contrato (PDF)"
    },
    "file_name": {
      "type": "string",
      "description": "Nome do arquivo"
    },
    "signed_file_url": {
      "type": "string",
      "description": "URL do contrato assinado"
    },
    "client_signed_at": {
      "type": "string",
      "description": "Data/hora da assinatura do cliente"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    },
    "visible_to_client": {
      "type": "boolean",
      "default": true,
      "description": "Vis\u00edvel ao cliente no portal"
    }
  },
  "required": [
    "project_id",
    "company_id",
    "title"
  ]
}