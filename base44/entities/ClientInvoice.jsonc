{
  "name": "ClientInvoice",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "ID do projeto relacionado"
    },
    "company_id": {
      "type": "string",
      "description": "ID da empresa cliente"
    },
    "invoice_number": {
      "type": "string",
      "description": "N\u00famero da fatura (ex: FAT-001)"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da cobran\u00e7a"
    },
    "amount": {
      "type": "number",
      "description": "Valor total da fatura"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "Data de vencimento"
    },
    "payment_date": {
      "type": "string",
      "format": "date",
      "description": "Data de pagamento (quando pago)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "overdue",
        "cancelled"
      ],
      "default": "pending",
      "description": "Status da fatura"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "boleto",
        "pix",
        "credit_card",
        "bank_transfer",
        "other"
      ],
      "description": "M\u00e9todo de pagamento"
    },
    "boleto_url": {
      "type": "string",
      "description": "URL do boleto para download"
    },
    "boleto_barcode": {
      "type": "string",
      "description": "C\u00f3digo de barras do boleto"
    },
    "pix_key": {
      "type": "string",
      "description": "Chave PIX para pagamento"
    },
    "pix_qrcode": {
      "type": "string",
      "description": "QR Code PIX (base64 ou URL)"
    },
    "receipt_url": {
      "type": "string",
      "description": "URL do comprovante de pagamento"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es internas"
    },
    "visible_to_client": {
      "type": "boolean",
      "default": true,
      "description": "Vis\u00edvel ao cliente no portal"
    },
    "installment_number": {
      "type": "number",
      "description": "N\u00famero da parcela (ex: 1)"
    },
    "total_installments": {
      "type": "number",
      "description": "Total de parcelas"
    }
  },
  "required": [
    "project_id",
    "company_id",
    "amount",
    "due_date"
  ]
}