{
  "name": "Auto-visibilidade de tarefas criadas",
  "description": "Quando uma nova tarefa \u00e9 criada, verifica se o projeto tem auto_visible_tasks ativo e marca a tarefa como vis\u00edvel ao cliente automaticamente.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Task"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_visibilidade_de_tarefas_criadas",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "onTaskCreated",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "onTaskCreated"
  }
}