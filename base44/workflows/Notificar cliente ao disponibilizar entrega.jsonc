{
  "name": "Notificar cliente ao disponibilizar entrega",
  "description": "Quando equipe cria ou atualiza status de entrega para \"delivered\" ou \"under_review\", notifica o cliente e envia email.",
  "trigger": {
    "condition": "${ (.trigger.data.status == \"delivered\" or .trigger.data.status == \"under_review\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "TaskDelivery"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notificar_cliente_ao_disponibilizar_entrega",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "onNewDelivery",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "onNewDelivery"
  }
}