{
  "name": "Company",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome da empresa"
    },
    "segment": {
      "type": "string",
      "description": "Segmento de atua\u00e7\u00e3o da empresa"
    },
    "logo_url": {
      "type": "string",
      "description": "URL do logo/foto da empresa"
    },
    "average_revenue": {
      "type": "number",
      "description": "Faturamento m\u00e9dio mensal da empresa"
    },
    "founded_year": {
      "type": "number",
      "description": "Ano de funda\u00e7\u00e3o da empresa"
    },
    "phone": {
      "type": "string",
      "description": "Telefone de contato"
    },
    "email": {
      "type": "string",
      "description": "Email de contato"
    },
    "address": {
      "type": "string",
      "description": "Endere\u00e7o da empresa"
    },
    "status": {
      "type": "string",
      "enum": [
        "lead",
        "client",
        "inactive"
      ],
      "default": "lead",
      "description": "Status da empresa no CRM"
    }
  },
  "required": [
    "name",
    "segment"
  ]
}