{
  "name": "FinancialTransaction",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "income",
        "expense"
      ],
      "description": "Tipo de movimenta\u00e7\u00e3o: entrada ou sa\u00edda"
    },
    "category": {
      "type": "string",
      "enum": [
        "sale",
        "service",
        "investment",
        "other_income",
        "transport",
        "tax",
        "tools",
        "salary",
        "rent",
        "utilities",
        "marketing",
        "supplies",
        "maintenance",
        "insurance",
        "professional_services",
        "other_expense"
      ],
      "description": "Categoria da movimenta\u00e7\u00e3o"
    },
    "amount": {
      "type": "number",
      "description": "Valor da movimenta\u00e7\u00e3o"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Data da movimenta\u00e7\u00e3o"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o detalhada"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "cash",
        "credit_card",
        "debit_card",
        "bank_transfer",
        "pix",
        "check"
      ],
      "description": "M\u00e9todo de pagamento"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "cancelled"
      ],
      "default": "completed",
      "description": "Status da transa\u00e7\u00e3o"
    },
    "company_id": {
      "type": "string",
      "description": "ID da empresa relacionada (se aplic\u00e1vel)"
    },
    "project_id": {
      "type": "string",
      "description": "ID do projeto relacionado (se aplic\u00e1vel)"
    },
    "recurring": {
      "type": "boolean",
      "default": false,
      "description": "Se \u00e9 uma movimenta\u00e7\u00e3o recorrente"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es adicionais"
    }
  },
  "required": [
    "type",
    "category",
    "amount",
    "date"
  ]
}