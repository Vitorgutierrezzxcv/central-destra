{
  "name": "Project",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do projeto"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o detalhada do projeto"
    },
    "color": {
      "type": "string",
      "enum": [
        "blue",
        "purple",
        "green",
        "orange",
        "pink",
        "red",
        "indigo",
        "teal"
      ],
      "default": "blue",
      "description": "Cor tem\u00e1tica do projeto"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "completed",
        "archived"
      ],
      "default": "active",
      "description": "Status do projeto"
    }
  },
  "required": [
    "name"
  ]
}