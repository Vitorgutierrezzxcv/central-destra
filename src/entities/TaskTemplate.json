{
  "name": "TaskTemplate",
  "type": "object",
  "properties": {
    "module_id": {
      "type": "string",
      "description": "ID do m\u00f3dulo ao qual o template pertence"
    },
    "title": {
      "type": "string",
      "description": "T\u00edtulo do template de tarefa"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do template"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium",
      "description": "Prioridade sugerida"
    },
    "estimated_days": {
      "type": "number",
      "description": "Dias estimados para conclus\u00e3o"
    },
    "order": {
      "type": "number",
      "description": "Ordem da tarefa no m\u00f3dulo"
    }
  },
  "required": [
    "module_id",
    "title"
  ]
}