{
  "name": "Opportunity",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "T\u00edtulo da oportunidade"
    },
    "company_id": {
      "type": "string",
      "description": "ID da empresa relacionada"
    },
    "value": {
      "type": "number",
      "description": "Valor estimado da oportunidade"
    },
    "stage": {
      "type": "string",
      "enum": [
        "prospecting",
        "qualification",
        "presentation",
        "negotiation",
        "closing",
        "post_sale"
      ],
      "default": "prospecting",
      "description": "Etapa atual no funil de vendas"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "won",
        "lost"
      ],
      "default": "open",
      "description": "Status da oportunidade"
    },
    "source": {
      "type": "string",
      "description": "Canal de origem do lead"
    },
    "probability": {
      "type": "number",
      "description": "Probabilidade de fechamento (0-100)"
    },
    "expected_close_date": {
      "type": "string",
      "format": "date",
      "description": "Data esperada de fechamento"
    },
    "actual_close_date": {
      "type": "string",
      "format": "date",
      "description": "Data real de fechamento"
    },
    "contact_name": {
      "type": "string",
      "description": "Nome do contato principal"
    },
    "contact_email": {
      "type": "string",
      "description": "Email do contato"
    },
    "contact_phone": {
      "type": "string",
      "description": "Telefone do contato"
    },
    "needs": {
      "type": "string",
      "description": "Necessidades identificadas"
    },
    "objections": {
      "type": "string",
      "description": "Obje\u00e7\u00f5es levantadas"
    },
    "next_step": {
      "type": "string",
      "description": "Pr\u00f3xima a\u00e7\u00e3o a ser realizada"
    },
    "assigned_to": {
      "type": "string",
      "description": "Email do respons\u00e1vel pela oportunidade"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium",
      "description": "Prioridade da oportunidade"
    }
  },
  "required": [
    "title",
    "company_id",
    "stage"
  ]
}